{
  "name": "careertwin-candidate",
  "version": "0.1.0",
  "private": true,
  "description": "Developer-first candidate operating system",
  "packageManager": "npm@10.5.0",
  "workspaces": [
    "apps/cli",
    "apps/tui",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "turbo run build",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "ct": "node apps/cli/dist/index.js"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "ts-node": "^10.9.1",
    "turbo": "latest"
  }
}
